# MongoDB local (servicio de Windows, sin Docker)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=bd_gastronomia_nosql

# Seguridad JWT (cambie la clave por una cadena larga y aleatoria)
JWT_SECRET=cambie_esta_clave_por_una_cadena_larga_y_aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Usuario de la API con mínimos privilegios (database/03_dcl_usuario_api.py).
# Déjelos vacíos solo si MongoDB no tiene la autenticación activada.
MONGO_USER=usr_gastronomia_api
MONGO_PASSWORD=cambie_esta_clave
